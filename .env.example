# Make.com (Integromat) webhook that fires the "thank you" automation
# when someone submits the join form (טופס הצטרפות).
#
# 1. In Make, create a scenario starting with a "Custom Webhook" module.
# 2. Copy the generated webhook URL.
# 3. Create a real ".env" file (copy this one) and paste the URL below.
# Vite only exposes vars prefixed with VITE_ to the browser.
VITE_MAKE_WEBHOOK_URL=https://hook.eu2.make.com/your-webhook-id-here

# Supabase — powers the staff dashboard (/dashboard.html) and the page-view
# counter. Find these in Supabase → Project Settings → API.
#   - VITE_SUPABASE_URL:      the Project URL (https://<ref>.supabase.co)
#   - VITE_SUPABASE_ANON_KEY: the "anon public" key.
# Both are safe to expose in the browser — the anon key is meant to be public,
# and Row-Level Security protects the data. NEVER put the service_role key here
# (that lives only in Make.com).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# The dashboard logs in with ONE shared staff account — the login form asks for
# a password only, and signs in against this address behind the scenes. Create
# the user once in Supabase → Authentication → Users, and rotate its password
# there whenever the team password should change. Optional: the code falls back
# to dashboard@fivefingers.co.il (src/dashboard/supabaseClient.js).
VITE_DASHBOARD_LOGIN_EMAIL=dashboard@fivefingers.co.il

# HubSpot needs NO variables here. Contact forms mirror every submission into
# HubSpot as a second, non-blocking destination (Make.com → Supabase stays the
# source of truth). Its two identifiers are public — the portal id already
# appears in the tracking script URL in index.html, the form guid in any HubSpot
# embed — so they live in code, at the top of src/lib/hubspot.js, where a
# forgotten env var can't silently switch the integration off in production.
